# Backend Environment Variables
NODE_ENV=development
PORT=3001
API_PREFIX=api

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=westos
DATABASE_PASSWORD=westos_dev_password
DATABASE_NAME=westos_dev
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
JWT_ISSUER=westos
JWT_AUDIENCE=westos-api

# Admin JWT (separate from customer)
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production
ADMIN_JWT_ACCESS_TOKEN_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Email (Twilio SendGrid)
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@westos.com
SENDGRID_FROM_NAME=Westos

# SMS/WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_PHONE_NUMBER=+1xxxx
TWILIO_WHATSAPP_NUMBER=+1xxxx

# Email (Alternative - AWS SES)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_SES_FROM_EMAIL=noreply@westos.com

# S3/Object Storage
AWS_S3_BUCKET=westos-dev
AWS_S3_REGION=ap-south-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_DOMAIN=

# Courier (Delhivery)
DELHIVERY_API_KEY=xxxx
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_WEBHOOK_SECRET=xxxx

# Feature Flags
FEATURE_BUYBACK_ENABLED=false
FEATURE_3D_VIEWER_ENABLED=true
FEATURE_ADVANCED_SEARCH_ENABLED=false

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Sentry
SENTRY_DSN=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json